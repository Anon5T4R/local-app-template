<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream metadata (software centres). package.sh substitutes @VERSION@ and @DATE@ from
     Cargo.toml and the build date. A born app rewrites this with its own description,
     screenshots and categories. -->
<component type="desktop-application">
  <id>com.localapp.app</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <name>Local App</name>
  <summary>Desktop template of the Local suite</summary>
  <developer id="com.localapp">
    <name>Local App contributors</name>
  </developer>
  <description>
    <p>
      Local App is the Local suite's desktop template: a Rust + egui window, an About window with
      an update check, a translated interface, native file pickers and the craft-fonts faces.
    </p>
  </description>
  <launchable type="desktop-id">com.localapp.app.desktop</launchable>
  <icon type="stock">com.localapp.app</icon>
  <!-- Only url types known to appstream 0.15 (Ubuntu 22.04, where CI validates): no vcs-browser. -->
  <url type="homepage">https://github.com/Anon5T4R/local-app-template</url>
  <url type="bugtracker">https://github.com/Anon5T4R/local-app-template/issues</url>
  <categories>
    <category>Utility</category>
  </categories>
  <keywords>
    <keyword>template</keyword>
    <keyword>local</keyword>
  </keywords>
  <requires>
    <display_length compare="ge">720</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
  </supports>
  <provides>
    <binary>localapp</binary>
  </provides>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="@VERSION@" date="@DATE@"/>
  </releases>
</component>
